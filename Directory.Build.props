<Project>

  <!-- Local-only machine overrides (e.g. artifact redirection). The file is
       gitignored and does not exist on CI — default MSBuild paths apply there. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Local.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <!-- SourceLink & Symbols -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Also embed PDB in the main nupkg for richer debugging when snupkg is not consumed -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <!-- NuGet package validation (API compat gate): compares the packed API surface
         against the last published baseline and fails the pack on breaking changes.
         Opt-in via -p:IranSmsValidatePackage=true (CI pack steps) so local builds
         never require baseline downloads from NuGet.org. -->
    <EnablePackageValidation Condition="'$(IranSmsValidatePackage)' == 'true'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0-beta.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata — single source of truth for all packages.
       Per-package values (PackageId, Description, PackageTags, PackageReadmeFile)
       stay in each csproj. VersionPrefix here is the local-build default; CI
       overrides the version from the git tag (see release.yml). -->
  <PropertyGroup>
    <Authors>IranSms Contributors</Authors>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/NimaHp/IranSMS</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NimaHp/IranSMS</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>