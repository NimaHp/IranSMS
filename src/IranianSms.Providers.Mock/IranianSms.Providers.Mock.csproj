<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>IranianSms.Providers.Mock</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>In-memory Mock provider for IranianSms — no network, deterministic ids, useful for tests and local development.</Description>
    <PackageTags>sms;ir;mock;iranian;provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IranianSms.Core\IranianSms.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IranianSms.Tests" />
  </ItemGroup>

</Project>
